{
  "info": {
    "name": "KisanSetu API \u2014 Regression Tests",
    "schema": "https://schema.postman.com/json/collection/v2.1.0/collection.json",
    "description": "Derived from main fb4534b. Run in order against a disposable local server. Creates unique supplier/buyer accounts and a product, exercises checkout, and deletes its product. Accounts/orders remain in memory until server restart. Weather/SMS are simulated by the application, not external provider verification."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "invalidToken",
      "value": "invalid-test-token"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health",
        "header": []
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"suffix\", String(Date.now()).slice(-9));",
              "pm.collectionVariables.set(\"supplierPhone\", \"7\"+pm.collectionVariables.get(\"suffix\"));",
              "pm.collectionVariables.set(\"buyerPhone\", \"8\"+pm.collectionVariables.get(\"suffix\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "const j = pm.response.json();",
              "pm.test(\"Healthy and timestamp\",()=>{pm.expect(j.status).to.eql(\"ok\");pm.expect(Number.isNaN(Date.parse(j.time))).to.eql(false);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Missing signup fields",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/signup",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 400\", () => pm.response.to.have.status(400));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "const j = pm.response.json();",
              "pm.test(\"Error message\",()=>pm.expect(j.message).to.be.a(\"string\").and.not.empty);"
            ]
          }
        }
      ]
    },
