    {
      "name": "Register supplier",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/auth/signup",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman supplier\", \"phone\": \"{{supplierPhone}}\", \"password\": \"Test123!local\", \"confirmPassword\": \"Test123!local\", \"location\": \"Hyderabad\", \"preferredLanguage\": \"te\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"JSON response\", () => pm.response.to.be.json);",
              "const j = pm.response.json();",
              "pm.test(\"Account created without password leak\",()=>{pm.expect(j.user.primaryRole).to.eql(\"unassigned\");pm.expect(j.user).not.to.have.property(\"passwordHash\");pm.expect(j.token).to.be.a(\"string\");});",
              "pm.collectionVariables.set(\"supplierToken\",j.token);pm.collectionVariables.set(\"supplierId\",j.user.id);"
            ]
          }
        }
      ]
    },
